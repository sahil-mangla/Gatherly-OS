# ==============================================================================
# Gatherly Environment Configuration Example
# Copy this file to .env and customize values for your deployment.
# NEVER commit a real .env: it holds secrets.
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=8080
DEBUG=false
# development | test | production. Defaults to "development" locally and "production" on Vercel.
# production: JWT_SECRET is mandatory, API docs are off, guest access is off, HSTS is on.
ENVIRONMENT=development
# Uvicorn worker processes (ignored when DEBUG=true / reload)
WEB_CONCURRENCY=1

# GenAI Intelligence Services (Google Gemini / Mara Copilot)
# Leave empty to run with Gatherly's offline deterministic domain fallback engine
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# CORS: comma-separated list of allowed browser origins, e.g. https://app.example.com
# Unset: same-origin only in production, "*" (no credentials) in development.
CORS_ORIGINS=

# ==============================================================================
# Enterprise Multi-Tenant SaaS Configuration
# ==============================================================================

# Database Persistence (PostgreSQL for Enterprise / SQLite for local development)
DATABASE_URL=sqlite:///./gatherly.db
# For PostgreSQL in Docker / Production:
# DATABASE_URL=postgresql://gatherly:<POSTGRES_PASSWORD>@localhost:5432/gatherly_enterprise
# docker compose reads this to create the database and build DATABASE_URL:
POSTGRES_PASSWORD=

# Authentication & RBAC Security
# JWT_SECRET signs every access token. It is REQUIRED (>= 32 random bytes) when
# ENVIRONMENT=production; the app refuses to start without it. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Vercel: set JWT_SECRET under Project Settings > Environment Variables. If it is missing the
# function still boots with a random per-instance secret (logged as a warning), but tokens then
# only validate on the instance that issued them. In development/test an unset secret is
# replaced by a random per-process one.
JWT_SECRET=
JWT_EXPIRATION_MINUTES=1440
# PBKDF2 work factor for NEW password hashes (older hashes still verify). Lower only in tests/CI.
PBKDF2_ITERATIONS=600000
# Production seeding: the studio tenant + planner@gatherly.app owner are created ONLY if this is
# set. In development/test the default seed password is used instead.
SEED_ADMIN_PASSWORD=
# Public sandbox: GET /api/auth/demo-token issues tokens scoped to the isolated "tenant-demo".
# Set false to disable the endpoint (404) and demo tenant seeding.
DEMO_MODE=true
# In-memory per-IP / per-user rate limits (login+register 10/min, /api/mara 30/min)
RATE_LIMIT_ENABLED=true
# Honour X-Forwarded-For for rate limiting; only enable behind a trusted proxy (auto-on for Vercel)
TRUST_PROXY=false

# Distributed Observability & Telemetry (Datadog / CloudWatch / ELK)
LOG_FORMAT=json
OTEL_ENABLED=true
OTEL_SERVICE_NAME=gatherly-backend
