# ==============================================================================
# Gatherly Environment Configuration Example
# Copy this file to .env and customize values for your deployment
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=8080
DEBUG=false
ENVIRONMENT=production

# GenAI Intelligence Services (Google Gemini / Mara Copilot)
# Leave empty to run with Gatherly's offline deterministic domain fallback engine
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Security & CORS (Comma-separated list of allowed origins)
ALLOWED_ORIGINS=*
