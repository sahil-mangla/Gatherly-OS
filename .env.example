# ==============================================================================
# Gatherly Environment Configuration Example
# Copy this file to .env and customize values for your deployment
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=8080
DEBUG=false
ENVIRONMENT=production

# GenAI Intelligence Services (Google Gemini / Mara Copilot)
# Leave empty to run with Gatherly's offline deterministic domain fallback engine
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Security & CORS (Comma-separated list of allowed origins)
ALLOWED_ORIGINS=*

# ==============================================================================
# Enterprise Multi-Tenant SaaS Configuration
# ==============================================================================

# Database Persistence (PostgreSQL for Enterprise / SQLite for local development)
DATABASE_URL=sqlite:///./gatherly.db
# For PostgreSQL in Docker / Production:
# DATABASE_URL=postgresql://gatherly:gatherly_secret_password@localhost:5432/gatherly_enterprise

# Authentication & RBAC Security (Change in production)
JWT_SECRET=gatherly-super-secure-enterprise-secret-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# Distributed Observability & Telemetry (Datadog / CloudWatch / ELK)
LOG_FORMAT=json
OTEL_ENABLED=true
OTEL_SERVICE_NAME=gatherly-backend

