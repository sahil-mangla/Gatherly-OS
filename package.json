{
  "name": "gatherly",
  "version": "1.0.0",
  "description": "Gatherly — Intelligent Celebration & Event Planning Assistant",
  "type": "module",
  "main": "server.mjs",
  "scripts": {
    "start": "python backend/run.py",
    "dev": "python backend/run.py",
    "test": "python -m pytest backend/tests && node --test frontend/tests/domain.test.js frontend/tests/event-dates.test.js frontend/tests/actions.test.js frontend/tests/e2e-contracts.test.js",
    "test:load": "python scripts/load_test.py --requests 200 --concurrency 30 --max-p95 150",
    "test:e2e": "npx playwright test",
    "lint": "ruff check backend",
    "format": "ruff format backend",
    "check:lines": "python scripts/check_line_limits.py",
    "docker:build": "docker build -t gatherly .",
    "docker:run": "docker run -p 8080:8080 --env-file .env gatherly",
    "docker:compose": "docker compose up --build"
  },
  "keywords": [
    "event-planning",
    "fastapi",
    "pydantic",
    "budget-dag",
    "timeline-dag",
    "vendor-quotes",
    "risk-radar",
    "mirofish-sandbox"
  ],
  "author": "Gatherly Team",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.42.0"
  }
}
